{
  "name": "ai-civilization",
  "version": "0.3.0",
  "private": false,
  "description": "A deterministic two-LLM civilization simulation with replayable research records and a public spectator UI.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun run --hot server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "build": "vite build",
    "start": "NODE_ENV=production bun run server.ts",
    "coordinator": "bun scripts/turn-coordinator.ts",
    "coordinator:once": "bun scripts/turn-coordinator.ts --once",
    "coordinator:probe": "bun scripts/turn-coordinator.ts --probe"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "hono": "^4.13.1",
    "marked": "^17.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "@types/bun": "1.2.21",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "vite": "^8.2.1",
    "typescript": "^5.9.3"
  }
}
